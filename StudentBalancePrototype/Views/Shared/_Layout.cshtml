<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentBalancePrototype</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prototype.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentBalancePrototype.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <main role="main" class="app-content">
            @RenderBody()
        </main>

        <nav class="bottom-nav">
            <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")">
                <span>🏠</span>
                <p>Home</p>
            </a>

            <a asp-controller="Home" asp-action="Academic" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Academic" ? "active" : "")">
                <span>📚</span>
                <p>Academic</p>
            </a>

            <a asp-controller="Home" asp-action="Wellness" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Wellness" ? "active" : "")">
                <span>🌿</span>
                <p>Wellness</p>
            </a>

            <a asp-controller="Home" asp-action="Motivation" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Motivation" ? "active" : "")">
                <span>🏆</span>
                <p>Motivation</p>
            </a>
        </nav>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
