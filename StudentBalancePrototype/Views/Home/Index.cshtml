@{
    ViewData["Title"] = "Student Balance Home";
    ViewData["ActivePage"] = "Home";
}

<div class="home-top-row">
    <div class="top-app-bar compact-logo-bar">
        <div class="brand-center">
            <h1>Student Balance</h1>
            <img src="~/images/student-balance-logo.png" alt="Student Balance logo" class="brand-logo" />
        </div>
    </div>

    <div class="profile-side">
        <div class="profile-icon">👤</div>
        <span>Profile</span>
    </div>
</div>

<div class="section-heading">
    <h3>Today’s Overview</h3>
    <p>Your academic and wellness summary</p>
</div>

<div class="overview-strip">
    <div>
        <span>📚</span>
        <p>2 tasks due soon</p>
    </div>

    <div>
        <span>🌿</span>
        <p>3 habits tracked</p>
    </div>
</div>

<div class="main-card upcoming-card">
    <div class="card-title-row">
        <h2>Upcoming Assignments</h2>
        <span class="badge-warning">Urgent</span>
    </div>

    <div class="assignment-item">
        <div>
            <strong>INSY Report</strong>
            <p>Interface design summative</p>
        </div>
        <span>2 days</span>
    </div>

    <div class="assignment-item">
        <div>
            <strong>PROG Task</strong>
            <p>Code review and testing</p>
        </div>
        <span>5 days</span>
    </div>
</div>

<div class="section-heading lower-heading">
    <h3>Balance Tracker</h3>
    <p>Daily habits and motivation</p>
</div>

<div class="small-card-grid">
    <div class="main-card small-card">
        <div class="small-icon green-icon">💧</div>
        <h3>Daily Habits</h3>
        <p>Sleep: 7h</p>
        <p>Water: 6 glasses</p>
    </div>

    <div class="main-card small-card">
        <div class="small-icon blue-icon">🔥</div>
        <h3>Streak</h3>
        <p class="streak-number">7 days</p>
        <p>Keep going!</p>
    </div>
</div>